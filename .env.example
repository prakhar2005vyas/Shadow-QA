# Shadow QA — environment variables
# Copy this to .env and fill in your values. Never commit .env.

# ---------- Unified OpenAI-compatible gateway ----------
# Both the VLM (vision/decision) and the reporting (Fireworks) clients route
# all requests through this single gateway endpoint.
# Point this at any OpenAI-compatible proxy (LiteLLM, vLLM, Ollama Cloud, etc.).
# Unified LLM Gateway: Handles both VLM and Fireworks routing
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=my_secure_local_password

# ---------- VLM / Vision-Decision layer (NEVER Fireworks) ----------
MOCK_VLM=true
VLM_MODEL_ID=gemma-4

# ---------- Reporting layer (text report writing ONLY) ----------
# Fireworks is NEVER used for vision/decision — only for writing polished bug reports.
FIREWORKS_MODEL_ID=llama-3.3-70b-versatile

# ---------- Agent budget ----------
MAX_STEPS_PER_RUN=20
MAX_SECONDS_PER_RUN=240

# ---------- Database ----------
DATABASE_URL=sqlite:////app/data/shadowqa.db
